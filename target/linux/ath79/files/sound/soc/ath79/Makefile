# Makefile for ASoC audio support on Atheros ath79 SoCs
#

obj-$(CONFIG_SND_SOC_ATH79_SOC) += snd-soc-ath79.o
snd-soc-ath79-objs := ath79-i2s-pll.o

obj-$(CONFIG_SND_SOC_ATH79_I2S) += snd-soc-ath79-i2s.o
snd-soc-ath79-i2s-objs := ath79-i2s.o

obj-$(CONFIG_SND_SOC_ATH79_MBOX) += snd-soc-ath79-mbox.o
snd-soc-ath79-mbox-objs := ath79-mbox.o

obj-$(CONFIG_SND_SOC_ATH79_PCM) += snd-soc-ath79-pcm.o
snd-soc-ath79-pcm-objs := ath79-pcm.o

obj-$(CONFIG_SND_SOC_ATH79_INTERNAL_CODEC) += snd-soc-ath79-internal-codec.o
snd-soc-ath79-internal-codec-objs := ath79-internal-codec.o

obj-$(CONFIG_SND_SOC_ATH79_AK4430) += snd-soc-ath79-ak4430.o
snd-soc-ath79-ak4430-objs := ak4430-codec.o

obj-$(CONFIG_SND_SOC_QCA_PISEN_WPR003N) += snd-soc-qca-pisen-wpr003n.o
snd-soc-qca-pisen-wpr003n-objs := qca-pisen-wpr003n.o
