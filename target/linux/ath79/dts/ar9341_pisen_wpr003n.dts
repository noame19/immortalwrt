#include "ar9341.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "PISEN WPR003N";
	compatible = "pisen,wpr003n", "qca,ar9341";

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
		label-mac-device = &wmac;
	};

	leds {
		compatible = "gpio-leds";

		led_power: power {
			label = "blue:power";
			gpios = <&gpio 4 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

	};

	keys {
		compatible = "gpio-keys";

		rfkill {
			label = "rfkill";
			linux,code = <KEY_RFKILL>;
			linux,input-type = <EV_SW>;
			gpios = <&gpio 18 GPIO_ACTIVE_HIGH>;
			debounce-interval = <60>;
		};

		reset {
			label = "Reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio 17 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};
};

&spi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			uboot: partition@0 {
				label = "u-boot";
				reg = <0x000000 0x020000>;
				read-only;
			};

			partition@20000 {
				compatible = "tplink,firmware";
				label = "firmware";
				reg = <0x020000 0xfd0000>;
			};

			art: partition@ff0000 {
				label = "art";
				reg = <0xff0000 0x010000>;
				read-only;
			};
		};
	};
};

&eth0 {
	status = "okay";

	phy-handle = <&swphy4>;

	mtd-mac-address = <&uboot 0x1fc00>;
	mtd-mac-address-increment = <(-1)>;
};

&eth1 {
	mtd-mac-address = <&uboot 0x1fc00>;

	gmac-config {
		device = <&gmac>;
		switch-phy-only_mode = <0>;
	};
};

&usb {
	status = "okay";
};

&usb_phy {
	status = "okay";
};

&wmac {
	status = "okay";
	mtd-cal-data = <&art 0x1000>;
};

&pll_audio {
	status = "okay";
};

&mbox {
	status = "okay";
};

&stereo {
	status = "okay";
};

&internal_codec {
	status = "okay";
};

&audio_pcm {
	status = "okay";
};

/*
 * AKM AK4430 codec (HW-mode, no I2C, see syb999's mach-pisen-wpr003n.c).
 * Wired to the I2S bus via GPIOs 11..14 (multiplexed onto
 * AR934X_GPIO_OUT_MUX_I2S_*).
 */
ak4430: ak4430-codec {
	compatible = "qca,ak4430";
	status = "okay";
};

/*
 * The ASoC machine card binds the AR9341 I2S controller to the
 * AK4430 codec. The DT phandles are resolved by the qca-pisen-wpr003n
 * machine driver at probe time.
 */
sound: sound {
	compatible = "pisen,wpr003n-snd", "qca,ar9341";

	cpu-dai = <&stereo>;
	codec-dai = <&ak4430>;

	model = "pisen-wpr003n";
};
